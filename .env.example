# Staff CRM login (default local dev: username 1, password 1)
STAFF_PASSWORD=1
STAFF_SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Local dev server (default 3001)
LOCAL_PORT=3001

# Upstash Redis (required on Vercel for persistent CRM/leads)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Option A — GoDaddy / workspace email (SMTP)
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_USER=info@mydermlounge.com
SMTP_PASS=

# Option B — Resend (requires mydermlounge.com verified in Resend dashboard)
RESEND_API_KEY=

CONTACT_TO=info@mydermlounge.com
CONTACT_FROM=DermLounge <info@mydermlounge.com>

# --- Twilio (SMS + Voice) ---
# My Derm Lounge wound care line: +1 (714) 706-3492
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Alternative to API key (not recommended for browser dialer):
# TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+17147063492
TWILIO_VOICE_CALLER_ID=+17147063492
# Personal cell for click-to-call bridge and inbound forward (NOT the Twilio number)
TWILIO_STAFF_CALLBACK_NUMBER=
TWILIO_VOICE_FORWARD_NUMBER=
# Public base URL for Twilio webhooks (production or ngrok tunnel)
TWILIO_WEBHOOK_BASE_URL=https://mydermlounge.com
# Twilio Console webhooks (HTTP POST):
#   SMS:   {TWILIO_WEBHOOK_BASE_URL}/api/twilio/inbound
#   Voice: {TWILIO_WEBHOOK_BASE_URL}/api/twilio/voice
#   Status: {TWILIO_WEBHOOK_BASE_URL}/api/twilio/voice/status
# Local dev: run a tunnel to port 3001 and set TWILIO_WEBHOOK_BASE_URL to the tunnel URL, or POST /api/admin/twilio { action: configure-webhooks } after login.
# Optional TwiML App SID for browser dialer (auto-provisioned from admin UI)
TWILIO_TWIML_APP_SID=

# SMS bot — set to 0 to disable inbound auto-replies (off until the Meta/CRM flow is approved)
SMS_BOT_ENABLED=0

# OpenAI — optional AI polish for SMS bot replies
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Meta Lead Ads (Facebook / Instagram Instant Forms) ---
# Primary path: Admin → Phone & SMS → Connect Meta (Facebook Login for Business).
# That stores a Page token derived from a long-lived user token (does not expire).
# Do not use Graph Explorer as the primary method — those tokens die in 1–2 hours.
META_PAGE_ID=107183565822734
META_PAGE_ACCESS_TOKEN=
META_APP_ID=
META_AD_ACCOUNT_ID=593540209723240
# Must match the Verify Token in Meta → Webhooks
META_VERIFY_TOKEN=dermlounge-lead-webhook
# App secret — verifies X-Hub-Signature-256 on leadgen webhooks AND appsecret_proof on Graph
META_APP_SECRET=
# Exact OAuth redirect URI (no trailing slash). Must also be pasted in the Meta app:
#   Facebook Login for Business → Settings → Valid OAuth Redirect URIs
META_OAUTH_REDIRECT_URI=https://mydermlounge.com/api/admin/meta/oauth/callback
# Local Connect Meta (add this URI in Meta too if you test on :3001):
#   http://localhost:3001/api/admin/meta/oauth/callback
# Optional Facebook Login for Business configuration ID (uses config permissions instead of scope)
# META_FB_LOGIN_CONFIG_ID=
# Keep 0 until auto-SMS copy is approved
META_LEAD_AUTO_SMS=0
# Optional. Vercel Cron sends Authorization: Bearer $CRON_SECRET
CRON_SECRET=
# Webhook callback URL (trailing slash required if the host redirects):
#   https://mydermlounge.com/api/meta/leads/
# After Connect Meta, the app subscribes the Page to leadgen. Backup poll: Vercel Cron hits /api/cron/meta-leads/ daily.

# Site URL fallback for webhooks
NEXT_PUBLIC_SITE_URL=https://mydermlounge.com
